---
import Section from "@/components/wrapper/Section.astro";
import PeopleHeader from "./PeopleHeader.astro";
import PeopleOverview from "./PeopleOverview.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import PeopleDirectory from "./PeopleDirectory.astro";
import Form from "@/components/form/Form.astro";
import Fieldset from "@/components/form/Fieldset.astro";
import Input from "@/components/form/Input.astro";
import Select from "@/components/form/Select.astro";
import Modal from "@/components/interactive/Modal.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import managerComboboxHelpersSource from "@/scripts/manager-combobox.js?raw";

const statuses = ["Active", "Onboarding", "Departing", "Inactive"];

---

<PeopleHeader />
<Section class="hris-dashboard_wrap" paddingTop="small" paddingBottom="small" gap="7">
  <PeopleOverview />
  <PeopleDirectory />
</Section>
<Modal id="employee-dialog" variant="side-panel" aria-labelledby="dialog-title">
  <Eyebrow>Employee record</Eyebrow>
  <Heading tag="h2" variant="h4" id="dialog-title">Edit employee</Heading>
  <Paragraph variant="small">Update the record, then save your changes.</Paragraph>
  <Form name="employee" id="employee-form" enhance={false} class="margin-top-6">
    <Fieldset legend="01 / Personal details">
      <Input label="Employee ID" name="id" required />
      <Input label="Display name" name="displayName" required />
      <Input label="Legal first name" name="legalFirstName" variant="first-name" />
      <Input label="Legal last name" name="legalLastName" variant="last-name" />
      <Input label="Other legal name" name="otherLegalName" />
      <Input label="Email" name="email" variant="email" />
    </Fieldset>
    <Fieldset legend="02 / Organisation">
      <Input label="Job title" name="jobTitle" />
      <Input label="Department" name="department" list="department-options" />
      <Input label="Cost center" name="costCenter" list="cost-center-options" />
      <div class="hris-dashboard_manager">
        <Input label="Manager" id="manager-input" name="manager" variant="search" role="combobox" aria-autocomplete="list" aria-controls="manager-options" aria-expanded="false" autocomplete="off" placeholder="Search employees" />
        <Button variant="link" id="manager-toggle" aria-label="Show manager options" aria-controls="manager-options" aria-expanded="false">Browse managers</Button>
        <div class="hris-dashboard_options" id="manager-options" role="listbox" aria-label="Managers" hidden></div>
      </div>
      <Input label="Branch" name="branch" list="branch-options" />
      <Input label="Office" name="office" list="office-options" />
      <Select label="Employment status" name="employmentStatus" value="Active" options={statuses} />
    </Fieldset>
    <Fieldset legend="03 / Employment dates">
      <Input label="Join date" name="joinDate" variant="date" autocomplete="off" />
      <Input label="Pending join date" name="pendingJoinDate" variant="date" autocomplete="off" />
      <Input label="Leave date" name="leaveDate" variant="date" autocomplete="off" />
      <Input label="Pending leave date" name="pendingLeaveDate" variant="date" autocomplete="off" />
    </Fieldset>
    <datalist id="department-options"></datalist>
    <datalist id="cost-center-options"></datalist>
    <datalist id="branch-options"></datalist>
    <datalist id="office-options"></datalist>
    <div id="employee-form-error" role="alert" hidden>
      <Paragraph variant="small"><span id="employee-form-error-message">Unable to save employee.</span></Paragraph>
    </div>
    <ButtonWrapper>
      <Button id="save-employee" type="submit">Save employee</Button>
      <Button emphasis="secondary" id="cancel-dialog">Cancel</Button>
    </ButtonWrapper>
  </Form>
</Modal>

<Modal id="identity-dialog" label="Authenticated identity">
  <Eyebrow>Cloudflare Access</Eyebrow>
  <Heading tag="h2" variant="h4">Authenticated identity</Heading>
  <Heading tag="h3" variant="h5" id="identity-dialog-name">Signed-in user</Heading>
  <Paragraph id="identity-dialog-email">—</Paragraph>
  <dl class="hris-dashboard_identity">
    <div><dt>Access identity ID</dt><dd id="identity-id">—</dd></div>
    <div><dt>Application audience</dt><dd id="identity-audience">—</dd></div>
    <div><dt>Entra groups</dt><dd id="identity-groups">None returned</dd></div>
  </dl>
  <Accordion>
    <AccordionItem heading="View identity payload"><pre class="hris-dashboard_payload" id="identity-json"></pre></AccordionItem>
  </Accordion>
</Modal>

<template id="employee-edit-button"><Button variant="link">Edit</Button></template>
<div class="hris-dashboard_toast theme-dark" id="toast" role="status" aria-live="polite"></div>
<script is:inline id="access-identity-data" type="application/json">__ACCESS_IDENTITY_JSON__</script>
<script is:inline set:html={managerComboboxHelpersSource}></script>

<script is:inline>
	let employees = [];
	let costCenters = [];
	let editingId = null;
	let originalManager = null;
	let loading = false;
	let saving = false;

	const rows = document.querySelector('#employee-rows');
	const search = document.querySelector('#employee-search');
	const departmentFilter = document.querySelector('#department-filter');
	const statusFilter = document.querySelector('#status-filter');
	const employeeCount = document.querySelector('#employee-count');
	const emptyState = document.querySelector('#empty-state');
	const dialog = document.querySelector('#employee-dialog');
	const form = document.querySelector('#employee-form');
	const toast = document.querySelector('#toast');
	const saveState = document.querySelector('#save-state');
	const managerInput = document.querySelector('#manager-input');
	const managerToggle = document.querySelector('#manager-toggle');
	const managerOptions = document.querySelector('#manager-options');
	const { isManagerAllowed, managerCandidates, nextManagerIndex, normalizeManager } = globalThis.managerComboboxHelpers;
	let visibleManagerNames = [];
	let activeManagerIndex = -1;

	function getAccessIdentity() {
		const element = document.querySelector('#access-identity-data');
		try {
			return JSON.parse(element?.textContent || '');
		} catch {
			return null;
		}
	}

	function displayName(identity) {
		return identity?.name || identity?.email?.split('@')[0] || 'Signed-in user';
	}

	function groupNames(groups) {
		if (!Array.isArray(groups)) return [];
		return groups.map((group) => typeof group === 'string' ? group : group?.name || group?.id).filter(Boolean);
	}

	function renderAccessIdentity() {
		const access = getAccessIdentity();
		const identity = access?.identity;
		if (!identity) return;

		const name = displayName(identity);
		const groups = groupNames(identity.groups);
		document.querySelector('#identity-name').textContent = name;
		document.querySelector('#identity-dialog-name').textContent = name;
		document.querySelector('#identity-dialog-email').textContent = identity.email || '—';
		document.querySelector('#identity-id').textContent = identity.user_uuid || identity.id || identity.sub || '—';
		document.querySelector('#identity-audience').textContent = access.aud || '—';
		document.querySelector('#identity-groups').textContent = groups.length ? groups.join(', ') : 'None returned';
		document.querySelector('#identity-json').textContent = JSON.stringify(access, null, 2);
	}

	function inferEmploymentStatus(employee) {
		if (employee.pendingLeaveDate) return 'Departing';
		if (employee.pendingJoinDate) return 'Onboarding';
		if (employee.leaveDate) return 'Inactive';
		return 'Active';
	}

	function normalizeEmployee(employee) {
		return {
			id: String(employee.id || ''),
			legalFirstName: String(employee.legalFirstName || ''),
			legalLastName: String(employee.legalLastName || ''),
			otherLegalName: String(employee.otherLegalName || ''),
			displayName: String(employee.displayName || ''),
			email: String(employee.email || ''),
			branch: String(employee.branch || ''),
			office: String(employee.office || ''),
			jobTitle: String(employee.jobTitle || ''),
			costCenter: String(employee.costCenter || ''),
			department: String(employee.department || ''),
			manager: String(employee.manager || ''),
			joinDate: String(employee.joinDate || ''),
			pendingJoinDate: String(employee.pendingJoinDate || ''),
			leaveDate: String(employee.leaveDate || ''),
			pendingLeaveDate: String(employee.pendingLeaveDate || ''),
			employmentStatus: employee.employmentStatus || inferEmploymentStatus(employee),
		};
	}

	function setDatabaseStatus(message, state = '') {
		saveState.classList.toggle('error', state === 'error');
		saveState.classList.toggle('saving', state === 'saving');
		saveState.querySelector('span:last-child').textContent = message;
	}

	async function apiRequest(url, options) {
		const response = await fetch(url, options);
		const result = await response.json().catch(() => ({}));
		if (!response.ok) throw new Error(result.message || 'Database request failed');
		return result;
	}

	async function loadEmployees(showConfirmation = false) {
		if (loading || saving) return;
		loading = true;
		document.querySelector('#reload-employees').disabled = true;
		document.querySelector('#directory-results').setAttribute('aria-busy', 'true');
		document.querySelector('#directory-error').hidden = true;
		setDatabaseStatus('Loading…', 'saving');
		try {
			const result = await apiRequest('/api/employees');
			employees = Array.isArray(result.employees) ? result.employees.map(normalizeEmployee) : [];
			costCenters = Array.isArray(result.costCenters) ? result.costCenters.map(String) : [];
			renderAll();
			setDatabaseStatus('Up to date');
			if (showConfirmation) showToast('Employee data reloaded');
		} catch (error) {
			setDatabaseStatus('Refresh failed', 'error');
			employeeCount.textContent = employees.length ? `${employees.length} people · showing previously loaded data` : 'Directory unavailable';
			document.querySelector('#directory-error').hidden = false;
			document.querySelector('#directory-error-message').textContent = employees.length ? 'Your last loaded records are still shown. Use Refresh directory to try again.' : 'Use Refresh directory to try again. Your records have not been changed.';
			showToast(error instanceof Error ? error.message : 'Database request failed');
		} finally {
			loading = false;
			document.querySelector('#reload-employees').disabled = false;
			document.querySelector('#directory-results').setAttribute('aria-busy', 'false');
		}
	}

	function unique(field) {
		return [...new Set(employees.map((employee) => employee[field]).filter(Boolean))].sort();
	}

	function closeManagerOptions() {
		managerOptions.hidden = true;
		managerInput.setAttribute('aria-expanded', 'false');
		managerToggle.setAttribute('aria-expanded', 'false');
		managerToggle.setAttribute('aria-label', 'Show manager options');
		managerInput.removeAttribute('aria-activedescendant');
		activeManagerIndex = -1;
	}

	function selectManager(name) {
		managerInput.value = name;
		managerInput.setCustomValidity('');
		closeManagerOptions();
		managerInput.focus();
	}

	function setActiveManager(index) {
		if (!visibleManagerNames.length) return;
		activeManagerIndex = index;
		const options = [...managerOptions.querySelectorAll('[role="option"]')];
		options.forEach((option, optionIndex) => option.setAttribute('aria-selected', String(optionIndex === activeManagerIndex)));
		const activeOption = options[activeManagerIndex];
		managerInput.setAttribute('aria-activedescendant', activeOption.id);
		activeOption.scrollIntoView({ block: 'nearest' });
	}

	function renderManagerOptions() {
		const query = managerInput.value.trim().toLocaleLowerCase();
		visibleManagerNames = managerCandidates(employees, editingId).filter((name) => !query || name.toLocaleLowerCase().includes(query));
		activeManagerIndex = -1;
		managerOptions.replaceChildren();

		if (!visibleManagerNames.length) {
			managerOptions.append(createText('div', 'hris-dashboard_empty-option', 'No matching employees'));
		} else {
			visibleManagerNames.forEach((name, index) => {
				const option = createText('button', 'hris-dashboard_option', name);
				option.type = 'button';
				option.id = `manager-option-${index}`;
				option.tabIndex = -1;
				option.setAttribute('role', 'option');
				option.setAttribute('aria-selected', 'false');
				option.addEventListener('pointerdown', (event) => event.preventDefault());
				option.addEventListener('click', () => selectManager(name));
				managerOptions.append(option);
			});
		}

		managerOptions.hidden = false;
		managerInput.setAttribute('aria-expanded', 'true');
		managerToggle.setAttribute('aria-expanded', 'true');
		managerToggle.setAttribute('aria-label', 'Hide manager options');
	}

	function validateManager() {
		const valid = isManagerAllowed(managerInput.value, managerCandidates(employees, editingId), originalManager);
		managerInput.setCustomValidity(valid ? '' : 'Select a manager from the employee list.');
		return valid;
	}

	function formatDate(value) {
		if (!value) return '—';
		const date = new Date(`${value}T00:00:00`);
		if (Number.isNaN(date.getTime())) return value;
		return new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' }).format(date);
	}

	function initials(name) {
		return String(name || '?').split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]).join('').toUpperCase();
	}

	function createText(tag, className, text) {
		const element = document.createElement(tag);
		if (className) element.className = className;
		element.textContent = text;
		return element;
	}

	function renderMetrics() {
		document.querySelector('#metric-total').textContent = employees.length;
		document.querySelector('#metric-departments').textContent = unique('department').length;
		document.querySelector('#metric-locations').textContent = unique('office').length;
		document.querySelector('#metric-onboarding').textContent = employees.filter((employee) => employee.employmentStatus === 'Onboarding').length;
	}

	function renderFilterOptions() {
		const selected = departmentFilter.value;
		departmentFilter.replaceChildren(new Option('All departments', ''));
		unique('department').forEach((department) => departmentFilter.add(new Option(department, department)));
		departmentFilter.value = unique('department').includes(selected) ? selected : '';

		const lists = {
			'department-options': unique('department'),
			'cost-center-options': [...new Set([...costCenters, ...unique('costCenter')])].sort(),
			'branch-options': unique('branch'),
			'office-options': unique('office'),
		};
		Object.entries(lists).forEach(([id, values]) => {
			const list = document.getElementById(id);
			list.replaceChildren(...values.map((value) => new Option(value)));
		});
	}

	function filteredEmployees() {
		const term = search.value.trim().toLocaleLowerCase();
		return employees.filter((employee) => {
			const searchable = [employee.displayName, employee.legalFirstName, employee.legalLastName, employee.otherLegalName, employee.id, employee.email, employee.jobTitle, employee.department].join(' ').toLocaleLowerCase();
			return (!term || searchable.includes(term)) && (!departmentFilter.value || employee.department === departmentFilter.value) && (statusFilter.value === 'all' || employee.employmentStatus === statusFilter.value);
		});
	}

	function buildEmployeeRow(employee) {
		const tr = document.createElement('tr');
		tr.tabIndex = 0;
		tr.dataset.employeeId = employee.id;
		tr.setAttribute('role', 'row');
		tr.setAttribute('aria-label', `Edit ${employee.displayName || employee.id}`);

		const personCell = document.createElement('td');
		const person = document.createElement('div');
		person.className = 'hris-dashboard_person';
		const avatar = createText('span', 'hris-dashboard_avatar', initials(employee.displayName));
		const personCopy = document.createElement('span');
		personCopy.append(createText('strong', '', employee.displayName || 'Unnamed employee'), createText('small', '', `${employee.id}${employee.email ? ` · ${employee.email}` : ''}`));
		person.append(avatar, personCopy);
		personCell.append(person);

		const roleCell = document.createElement('td');
		roleCell.append(createText('strong', 'hris-dashboard_primary', employee.jobTitle || '—'), createText('small', 'hris-dashboard_secondary', employee.manager ? `Reports to ${employee.manager}` : 'No manager'));
		const departmentCell = createText('td', '', employee.department || '—');
		const locationCell = createText('td', '', employee.office || '—');
		const dateCell = createText('td', '', formatDate(employee.joinDate || employee.pendingJoinDate));
		const statusCell = document.createElement('td');
		const statusBadge = createText('span', 'hris-dashboard_status', employee.employmentStatus);
		statusBadge.dataset.status = employee.employmentStatus;
		statusCell.append(statusBadge);
		const actionCell = document.createElement('td');
		const editButton = document.querySelector('#employee-edit-button').content.firstElementChild.cloneNode(true);
		editButton.type = 'button';
		editButton.setAttribute('aria-label', `Edit ${employee.displayName || employee.id}`);
		editButton.addEventListener('click', (event) => { event.stopPropagation(); openEmployee(employee.id); });
		actionCell.append(editButton);

		tr.append(personCell, roleCell, departmentCell, locationCell, dateCell, statusCell, actionCell);
		[...tr.cells].forEach((cell, index) => {
			cell.setAttribute('role', 'cell');
			if (index > 0 && index < 6) cell.dataset.label = ['Employee', 'Role & manager', 'Department', 'Office', 'Join date', 'Status'][index];
		});
		tr.addEventListener('click', () => openEmployee(employee.id));
		tr.addEventListener('keydown', (event) => { if (event.target === tr && event.key === 'Enter') openEmployee(employee.id); });
		return tr;
	}

	function renderTable() {
		const visible = filteredEmployees();
		rows.replaceChildren(...visible.map(buildEmployeeRow));
		employeeCount.textContent = `${visible.length} of ${employees.length} people`;
		emptyState.hidden = visible.length > 0;
		document.querySelector('#empty-title').textContent = employees.length ? 'No matching people' : 'Your directory starts here';
		document.querySelector('#empty-description').textContent = employees.length ? 'Try another name or clear your filters.' : 'Add your first employee to bring your team together.';
	}

	function openEmployee(id = null) {
		if (saving || loading) return;
		editingId = id;
		form.reset();
		document.querySelector('#employee-form-error').hidden = true;
		managerInput.setCustomValidity('');
		closeManagerOptions();
		const employee = id ? employees.find((item) => item.id === id) : normalizeEmployee({ employmentStatus: 'Active' });
		originalManager = id ? employee.manager : null;
		document.querySelector('#dialog-title').textContent = id ? 'Edit employee' : 'Add employee';
		for (const [field, value] of Object.entries(employee)) {
			if (form.elements[field]) form.elements[field].value = value ?? '';
		}
		dialog.showModal();
		dialog.querySelector('[data-modal-scroll]').scrollTop = 0;
		setTimeout(() => form.elements.id.focus(), 0);
	}

	function closeDialog() {
		closeManagerOptions();
		dialog.close();
		editingId = null;
		originalManager = null;
	}

	function showToast(message) {
		toast.textContent = message;
		toast.classList.add('show');
		setTimeout(() => toast.classList.remove('show'), 2200);
	}

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (saving || loading) return;
		managerInput.value = normalizeManager(managerInput.value);
		if (!validateManager()) {
			managerInput.reportValidity();
			managerInput.focus();
			return;
		}
		const values = Object.fromEntries(new FormData(form).entries());
		const existingIndex = editingId ? employees.findIndex((employee) => employee.id === editingId) : -1;
		const endpoint = existingIndex >= 0 ? `/api/employees/${encodeURIComponent(editingId)}` : '/api/employees';
		const submitButton = document.querySelector('#save-employee');
		const formError = document.querySelector('#employee-form-error');
		formError.hidden = true;
		submitButton.disabled = true;
		saving = true;
		document.querySelector('#reload-employees').disabled = true;
		form.setAttribute('aria-busy', 'true');
		setDatabaseStatus('Saving…', 'saving');
		try {
			const result = await apiRequest(endpoint, {
				method: existingIndex >= 0 ? 'PUT' : 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(values),
			});
			const employee = normalizeEmployee(result.employee);
			if (existingIndex >= 0) employees[existingIndex] = employee;
			else employees.push(employee);
			renderAll();
			closeDialog();
			setDatabaseStatus('All changes saved');
			showToast(existingIndex >= 0 ? 'Employee updated' : 'Employee added');
		} catch (error) {
			setDatabaseStatus('Save failed', 'error');
			document.querySelector('#employee-form-error-message').textContent = error instanceof Error ? error.message : 'Employee save failed';
			formError.hidden = false;
			showToast(error instanceof Error ? error.message : 'Employee save failed');
		} finally {
			saving = false;
			submitButton.disabled = false;
			document.querySelector('#reload-employees').disabled = false;
			form.setAttribute('aria-busy', 'false');
		}
	});

	search.addEventListener('input', renderTable);
	search.addEventListener('search', renderTable);
	document.querySelector('#clear-filters').addEventListener('click', () => {
		search.value = '';
		departmentFilter.value = '';
		statusFilter.value = 'all';
		renderTable();
		search.focus();
	});
	departmentFilter.addEventListener('change', renderTable);
	statusFilter.addEventListener('change', renderTable);
	managerInput.addEventListener('focus', renderManagerOptions);
	managerInput.addEventListener('input', () => {
		managerInput.setCustomValidity('');
		renderManagerOptions();
	});
	managerInput.addEventListener('blur', () => {
		validateManager();
		setTimeout(closeManagerOptions, 0);
	});
	managerInput.addEventListener('keydown', (event) => {
		if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
			event.preventDefault();
			if (managerOptions.hidden) renderManagerOptions();
			setActiveManager(nextManagerIndex(activeManagerIndex, visibleManagerNames.length, event.key === 'ArrowDown' ? 1 : -1));
		} else if (event.key === 'Enter' && !managerOptions.hidden && activeManagerIndex >= 0) {
			event.preventDefault();
			selectManager(visibleManagerNames[activeManagerIndex]);
		} else if (event.key === 'Escape') {
			event.preventDefault();
			event.stopPropagation();
			closeManagerOptions();
		}
	});
	managerToggle.addEventListener('click', () => {
		const shouldOpen = managerOptions.hidden;
		managerInput.focus();
		if (shouldOpen && managerOptions.hidden) renderManagerOptions();
		else if (!shouldOpen) closeManagerOptions();
	});
	document.addEventListener('click', (event) => {
		if (!event.target.closest('.hris-dashboard_manager')) closeManagerOptions();
	});
	document.querySelector('#add-employee').addEventListener('click', () => openEmployee());
	document.querySelector('#cancel-dialog').addEventListener('click', closeDialog);
	dialog.addEventListener('close', () => { closeManagerOptions(); editingId = null; originalManager = null; });
	document.querySelector('#reload-employees').addEventListener('click', () => loadEmployees(true));

	function renderAll() {
		renderMetrics();
		renderFilterOptions();
		renderTable();
	}

	renderAccessIdentity();
	loadEmployees();
</script>


<style is:global>
  @layer components {
    .hris-dashboard_manager { position: relative; display: grid; gap: var(--space-2); }
    .hris-dashboard_options {
      position: absolute; inset-inline: 0; top: 100%; z-index: 2;
      max-height: 12rem; overflow-y: auto; background: var(--background);
      border: var(--border-width) solid var(--border); border-radius: var(--radius-small);
    }
    .hris-dashboard_option {
      display: block; width: 100%; padding: var(--space-3);
      text-align: start; color: var(--text); background: var(--background);
      &:hover, &[aria-selected="true"] { background: var(--background-2); }
    }
    .hris-dashboard_empty-option { padding: var(--space-3); color: var(--text-2); }
    .hris-dashboard_identity {
      display: grid; gap: var(--space-4); margin-block: var(--space-6);
      dt { color: var(--text-2); }
      dd { margin: 0; overflow-wrap: anywhere; }
    }
    .hris-dashboard_payload { max-height: 20rem; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; }
    .hris-dashboard_toast {
      position: fixed; inset-inline-end: var(--site-margin); bottom: var(--site-margin);
      z-index: 10; padding: var(--space-4) var(--space-5);
      border-radius: var(--radius-small); background: var(--background); color: var(--text);
      max-width: calc(100% - var(--site-margin) * 2); opacity: 0; pointer-events: none;
      &.show { opacity: 1; }
    }
  }
</style>
