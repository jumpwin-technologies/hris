---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<header class="topbar">
			<button class="identity-button" id="identity-button" type="button" aria-haspopup="dialog">
				<span class="identity-avatar" id="identity-avatar" aria-hidden="true">?</span>
				<span class="identity-copy">
					<strong id="identity-name">Signed in</strong>
					<small id="identity-email">Cloudflare Access</small>
				</span>
				<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4" /></svg>
			</button>
			<div class="local-status" id="save-state" role="status" aria-live="polite">
				<span class="status-dot"></span>
				<span>Cloud database</span>
			</div>
		</header>

		<main>
			<section class="page-heading">
				<div>
					<p class="eyebrow">Employee directory</p>
					<h1>People dashboard</h1>
					<p>Keep employee information current in one simple workspace.</p>
				</div>
				<button class="button primary" id="add-employee" type="button">
					<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
					Add employee
				</button>
			</section>

			<section class="metrics" aria-label="Employee summary">
				<article class="metric-card">
					<span class="metric-icon green"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg></span>
					<div><span>Total people</span><strong id="metric-total">—</strong></div>
				</article>
				<article class="metric-card">
					<span class="metric-icon blue"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 21h18M5 21V7l7-4v18M19 21V11l-7-4M8 9h1M8 13h1M8 17h1M15 13h1M15 17h1" /></svg></span>
					<div><span>Departments</span><strong id="metric-departments">—</strong></div>
				</article>
				<article class="metric-card">
					<span class="metric-icon amber"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg></span>
					<div><span>Offices</span><strong id="metric-locations">—</strong></div>
				</article>
				<article class="metric-card">
					<span class="metric-icon violet"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v15H3V6a2 2 0 0 1 2-2Z" /><path d="m9 16 2 2 4-4" /></svg></span>
					<div><span>Onboarding</span><strong id="metric-onboarding">—</strong></div>
				</article>
			</section>

			<section class="directory-card" aria-labelledby="directory-title">
				<div class="directory-toolbar">
					<div>
						<h2 id="directory-title">Employees</h2>
						<p id="employee-count">Loading…</p>
					</div>
					<div class="filters">
						<label class="search-box" for="employee-search">
							<svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
							<input id="employee-search" type="search" autocomplete="off" placeholder="Search people" />
						</label>
						<label class="select-wrap">
							<span class="sr-only">Department</span>
							<select id="department-filter"><option value="">All departments</option></select>
							<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4" /></svg>
						</label>
						<label class="select-wrap">
							<span class="sr-only">Status</span>
							<select id="status-filter">
								<option value="">All statuses</option>
								<option>Active</option>
								<option>Onboarding</option>
								<option>Departing</option>
								<option>Inactive</option>
							</select>
							<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4" /></svg>
						</label>
					</div>
				</div>

				<div class="table-wrap">
					<table>
						<thead>
							<tr>
								<th scope="col">Employee</th>
								<th scope="col">Role</th>
								<th scope="col">Department</th>
								<th scope="col">Office</th>
								<th scope="col">Join date</th>
								<th scope="col">Status</th>
								<th scope="col"><span class="sr-only">Actions</span></th>
							</tr>
						</thead>
						<tbody id="employee-rows"></tbody>
					</table>
					<div class="empty-state" id="empty-state" hidden>
						<svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
						<h3>No employees found</h3>
						<p>Try a different search or filter.</p>
					</div>
				</div>

				<footer class="directory-footer">
					<p><span class="status-dot"></span> Changes save automatically to Cloudflare D1</p>
					<button class="text-button" id="reload-employees" type="button">Reload database</button>
				</footer>
			</section>
		</main>

		<dialog id="employee-dialog">
			<form id="employee-form" method="dialog">
				<header class="dialog-header">
					<div>
						<p class="eyebrow">Employee record</p>
						<h2 id="dialog-title">Edit employee</h2>
					</div>
					<button class="icon-button" id="close-dialog" type="button" aria-label="Close">
						<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg>
					</button>
				</header>

				<div class="form-grid">
					<label><span>Employee ID</span><input name="id" required /></label>
					<label><span>Display name</span><input name="displayName" required /></label>
					<label><span>Legal first name</span><input name="legalFirstName" /></label>
					<label><span>Legal last name</span><input name="legalLastName" /></label>
					<label class="wide"><span>Other legal name</span><input name="otherLegalName" /></label>
					<label class="wide"><span>Email</span><input name="email" type="email" /></label>
					<label><span>Job title</span><input name="jobTitle" /></label>
					<label><span>Department</span><input name="department" list="department-options" /></label>
					<label><span>Cost center</span><input name="costCenter" list="cost-center-options" /></label>
					<label><span>Manager</span><input name="manager" list="manager-options" /></label>
					<label><span>Branch</span><input name="branch" list="branch-options" /></label>
					<label><span>Office</span><input name="office" list="office-options" /></label>
					<label><span>Join date</span><input name="joinDate" type="date" /></label>
					<label><span>Pending join date</span><input name="pendingJoinDate" type="date" /></label>
					<label><span>Leave date</span><input name="leaveDate" type="date" /></label>
					<label><span>Pending leave date</span><input name="pendingLeaveDate" type="date" /></label>
					<label><span>Employment status</span><select name="employmentStatus"><option>Active</option><option>Onboarding</option><option>Departing</option><option>Inactive</option></select></label>
				</div>

				<datalist id="department-options"></datalist>
				<datalist id="cost-center-options"></datalist>
				<datalist id="manager-options"></datalist>
				<datalist id="branch-options"></datalist>
				<datalist id="office-options"></datalist>

				<footer class="dialog-actions">
					<button class="button secondary" id="cancel-dialog" type="button">Cancel</button>
					<button class="button primary" type="submit">Save employee</button>
				</footer>
			</form>
		</dialog>

		<dialog class="identity-dialog" id="identity-dialog">
			<header class="dialog-header">
				<div>
					<p class="eyebrow">Cloudflare Access</p>
					<h2>Authenticated identity</h2>
				</div>
				<button class="icon-button" id="close-identity-dialog" type="button" aria-label="Close">
					<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg>
				</button>
			</header>
			<div class="identity-details">
				<div class="identity-hero">
					<span class="identity-avatar large" id="identity-dialog-avatar" aria-hidden="true">?</span>
					<div><strong id="identity-dialog-name">Signed-in user</strong><span id="identity-dialog-email">—</span></div>
				</div>
				<dl>
					<div><dt>Access identity ID</dt><dd id="identity-id">—</dd></div>
					<div><dt>Application audience</dt><dd id="identity-audience">—</dd></div>
					<div><dt>Entra groups</dt><dd id="identity-groups">None returned</dd></div>
				</dl>
				<details>
					<summary>View identity payload</summary>
					<pre id="identity-json"></pre>
				</details>
			</div>
		</dialog>

		<div class="toast" id="toast" role="status" aria-live="polite"></div>
		<script is:inline id="access-identity-data" type="application/json">__ACCESS_IDENTITY_JSON__</script>

		<script>
			let employees = [];
			let costCenters = [];
			let editingId = null;

			const rows = document.querySelector('#employee-rows');
			const search = document.querySelector('#employee-search');
			const departmentFilter = document.querySelector('#department-filter');
			const statusFilter = document.querySelector('#status-filter');
			const employeeCount = document.querySelector('#employee-count');
			const emptyState = document.querySelector('#empty-state');
			const dialog = document.querySelector('#employee-dialog');
			const form = document.querySelector('#employee-form');
			const toast = document.querySelector('#toast');
			const saveState = document.querySelector('#save-state');
			const identityDialog = document.querySelector('#identity-dialog');

			function getAccessIdentity() {
				const element = document.querySelector('#access-identity-data');
				try {
					return JSON.parse(element?.textContent || '');
				} catch {
					return null;
				}
			}

			function displayName(identity) {
				return identity?.name || identity?.email?.split('@')[0] || 'Signed-in user';
			}

			function groupNames(groups) {
				if (!Array.isArray(groups)) return [];
				return groups.map((group) => typeof group === 'string' ? group : group?.name || group?.id).filter(Boolean);
			}

			function renderAccessIdentity() {
				const access = getAccessIdentity();
				const identity = access?.identity;
				if (!identity) return;

				const name = displayName(identity);
				const avatar = initials(name);
				const groups = groupNames(identity.groups);
				document.querySelector('#identity-name').textContent = name;
				document.querySelector('#identity-email').textContent = identity.email || 'Cloudflare Access';
				document.querySelector('#identity-avatar').textContent = avatar;
				document.querySelector('#identity-dialog-avatar').textContent = avatar;
				document.querySelector('#identity-dialog-name').textContent = name;
				document.querySelector('#identity-dialog-email').textContent = identity.email || '—';
				document.querySelector('#identity-id').textContent = identity.user_uuid || identity.id || identity.sub || '—';
				document.querySelector('#identity-audience').textContent = access.aud || '—';
				document.querySelector('#identity-groups').textContent = groups.length ? groups.join(', ') : 'None returned';
				document.querySelector('#identity-json').textContent = JSON.stringify(access, null, 2);
			}

			function inferEmploymentStatus(employee) {
				if (employee.pendingLeaveDate) return 'Departing';
				if (employee.pendingJoinDate) return 'Onboarding';
				if (employee.leaveDate) return 'Inactive';
				return 'Active';
			}

			function normalizeEmployee(employee) {
				return {
					id: String(employee.id || ''),
					legalFirstName: String(employee.legalFirstName || ''),
					legalLastName: String(employee.legalLastName || ''),
					otherLegalName: String(employee.otherLegalName || ''),
					displayName: String(employee.displayName || ''),
					email: String(employee.email || ''),
					branch: String(employee.branch || ''),
					office: String(employee.office || ''),
					jobTitle: String(employee.jobTitle || ''),
					costCenter: String(employee.costCenter || ''),
					department: String(employee.department || ''),
					manager: String(employee.manager || ''),
					joinDate: String(employee.joinDate || ''),
					pendingJoinDate: String(employee.pendingJoinDate || ''),
					leaveDate: String(employee.leaveDate || ''),
					pendingLeaveDate: String(employee.pendingLeaveDate || ''),
					employmentStatus: employee.employmentStatus || inferEmploymentStatus(employee),
				};
			}

			function setDatabaseStatus(message, state = '') {
				saveState.classList.toggle('error', state === 'error');
				saveState.classList.toggle('saving', state === 'saving');
				saveState.querySelector('span:last-child').textContent = message;
			}

			async function apiRequest(url, options) {
				const response = await fetch(url, options);
				const result = await response.json().catch(() => ({}));
				if (!response.ok) throw new Error(result.message || 'Database request failed');
				return result;
			}

			async function loadEmployees(showConfirmation = false) {
				setDatabaseStatus('Loading…', 'saving');
				try {
					const result = await apiRequest('/api/employees');
					employees = Array.isArray(result.employees) ? result.employees.map(normalizeEmployee) : [];
					costCenters = Array.isArray(result.costCenters) ? result.costCenters.map(String) : [];
					renderAll();
					setDatabaseStatus('Cloud database');
					if (showConfirmation) showToast('Employee data reloaded');
				} catch (error) {
					setDatabaseStatus('Database unavailable', 'error');
					employeeCount.textContent = 'Unable to load employees';
					showToast(error instanceof Error ? error.message : 'Database request failed');
				}
			}

			function unique(field) {
				return [...new Set(employees.map((employee) => employee[field]).filter(Boolean))].sort();
			}

			function formatDate(value) {
				if (!value) return '—';
				const date = new Date(`${value}T00:00:00`);
				if (Number.isNaN(date.getTime())) return value;
				return new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' }).format(date);
			}

			function initials(name) {
				return String(name || '?').split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]).join('').toUpperCase();
			}

			function createText(tag, className, text) {
				const element = document.createElement(tag);
				if (className) element.className = className;
				element.textContent = text;
				return element;
			}

			function renderMetrics() {
				document.querySelector('#metric-total').textContent = employees.length;
				document.querySelector('#metric-departments').textContent = unique('department').length;
				document.querySelector('#metric-locations').textContent = unique('office').length;
				document.querySelector('#metric-onboarding').textContent = employees.filter((employee) => employee.employmentStatus === 'Onboarding').length;
			}

			function renderFilterOptions() {
				const selected = departmentFilter.value;
				departmentFilter.replaceChildren(new Option('All departments', ''));
				unique('department').forEach((department) => departmentFilter.add(new Option(department, department)));
				departmentFilter.value = selected;

				const lists = {
					'department-options': unique('department'),
					'cost-center-options': [...new Set([...costCenters, ...unique('costCenter')])].sort(),
					'manager-options': unique('manager'),
					'branch-options': unique('branch'),
					'office-options': unique('office'),
				};
				Object.entries(lists).forEach(([id, values]) => {
					const list = document.getElementById(id);
					list.replaceChildren(...values.map((value) => new Option(value)));
				});
			}

			function filteredEmployees() {
				const term = search.value.trim().toLocaleLowerCase();
				return employees.filter((employee) => {
					const searchable = [employee.displayName, employee.legalFirstName, employee.legalLastName, employee.otherLegalName, employee.id, employee.email, employee.jobTitle, employee.department].join(' ').toLocaleLowerCase();
					return (!term || searchable.includes(term)) && (!departmentFilter.value || employee.department === departmentFilter.value) && (!statusFilter.value || employee.employmentStatus === statusFilter.value);
				});
			}

			function buildEmployeeRow(employee, index) {
				const tr = document.createElement('tr');
				tr.tabIndex = 0;
				tr.dataset.employeeId = employee.id;
				tr.setAttribute('aria-label', `Edit ${employee.displayName || employee.id}`);

				const personCell = document.createElement('td');
				const person = document.createElement('div');
				person.className = 'person';
				const avatar = createText('span', `avatar tone-${index % 5}`, initials(employee.displayName));
				const personCopy = document.createElement('span');
				personCopy.append(createText('strong', '', employee.displayName || 'Unnamed employee'), createText('small', '', `${employee.id}${employee.email ? ` · ${employee.email}` : ''}`));
				person.append(avatar, personCopy);
				personCell.append(person);

				const roleCell = document.createElement('td');
				roleCell.append(createText('strong', 'cell-primary', employee.jobTitle || '—'), createText('small', 'cell-secondary', employee.manager ? `Reports to ${employee.manager}` : 'No manager'));
				const departmentCell = createText('td', '', employee.department || '—');
				const locationCell = createText('td', '', employee.office || '—');
				const dateCell = createText('td', '', formatDate(employee.joinDate || employee.pendingJoinDate));
				const statusCell = document.createElement('td');
				statusCell.append(createText('span', `status-badge ${employee.employmentStatus.toLowerCase()}`, employee.employmentStatus));
				const actionCell = document.createElement('td');
				const editButton = document.createElement('button');
				editButton.type = 'button';
				editButton.className = 'edit-button';
				editButton.textContent = 'Edit';
				editButton.addEventListener('click', (event) => { event.stopPropagation(); openEmployee(employee.id); });
				actionCell.append(editButton);

				tr.append(personCell, roleCell, departmentCell, locationCell, dateCell, statusCell, actionCell);
				tr.addEventListener('click', () => openEmployee(employee.id));
				tr.addEventListener('keydown', (event) => { if (event.key === 'Enter') openEmployee(employee.id); });
				return tr;
			}

			function renderTable() {
				const visible = filteredEmployees();
				rows.replaceChildren(...visible.map(buildEmployeeRow));
				employeeCount.textContent = `${visible.length} of ${employees.length} people`;
				emptyState.hidden = visible.length > 0;
			}

			function openEmployee(id = null) {
				editingId = id;
				form.reset();
				const employee = id ? employees.find((item) => item.id === id) : normalizeEmployee({ employmentStatus: 'Active' });
				document.querySelector('#dialog-title').textContent = id ? 'Edit employee' : 'Add employee';
				for (const [field, value] of Object.entries(employee)) {
					if (form.elements[field]) form.elements[field].value = value ?? '';
				}
				dialog.showModal();
				setTimeout(() => form.elements.id.focus(), 0);
			}

			function closeDialog() {
				dialog.close();
				editingId = null;
			}

			function showToast(message) {
				toast.textContent = message;
				toast.classList.add('show');
				setTimeout(() => toast.classList.remove('show'), 2200);
			}

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				const values = Object.fromEntries(new FormData(form).entries());
				const existingIndex = editingId ? employees.findIndex((employee) => employee.id === editingId) : -1;
				const endpoint = existingIndex >= 0 ? `/api/employees/${encodeURIComponent(editingId)}` : '/api/employees';
				const submitButton = form.querySelector('button[type="submit"]');
				submitButton.disabled = true;
				setDatabaseStatus('Saving…', 'saving');
				try {
					const result = await apiRequest(endpoint, {
						method: existingIndex >= 0 ? 'PUT' : 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(values),
					});
					const employee = normalizeEmployee(result.employee);
					if (existingIndex >= 0) employees[existingIndex] = employee;
					else employees.push(employee);
					renderAll();
					closeDialog();
					setDatabaseStatus('Saved to D1');
					showToast(existingIndex >= 0 ? 'Employee updated in D1' : 'Employee added to D1');
					setTimeout(() => setDatabaseStatus('Cloud database'), 1500);
				} catch (error) {
					setDatabaseStatus('Save failed', 'error');
					showToast(error instanceof Error ? error.message : 'Employee save failed');
				} finally {
					submitButton.disabled = false;
				}
			});

			search.addEventListener('input', renderTable);
			departmentFilter.addEventListener('change', renderTable);
			statusFilter.addEventListener('change', renderTable);
			document.querySelector('#add-employee').addEventListener('click', () => openEmployee());
			document.querySelector('#close-dialog').addEventListener('click', closeDialog);
			document.querySelector('#cancel-dialog').addEventListener('click', closeDialog);
			dialog.addEventListener('click', (event) => { if (event.target === dialog) closeDialog(); });
			document.querySelector('#identity-button').addEventListener('click', () => identityDialog.showModal());
			document.querySelector('#close-identity-dialog').addEventListener('click', () => identityDialog.close());
			identityDialog.addEventListener('click', (event) => { if (event.target === identityDialog) identityDialog.close(); });
			document.querySelector('#reload-employees').addEventListener('click', () => loadEmployees(true));

			function renderAll() {
				renderMetrics();
				renderFilterOptions();
				renderTable();
			}

			renderAccessIdentity();
			loadEmployees();
		</script>
	</body>
</html>
